# ═══════════════════════════════════════════════════════════════
#  OCTOPUS — Variables de Entorno para STAGING (Backend Django)
#  Copia este archivo como .env DENTRO DEL CHECKOUT DE STAGING
#  (ej. /var/www/octopus-staging/octopus-api/.env) y completa los
#  valores reales de staging. NUNCA reutilices un .env de producción
#  ni copies valores reales de producción aquí.
#
#  Ver STAGING.md (raíz del repo) para el diseño completo de
#  aislamiento: directorio, dominio, BD, Redis, media, servicios
#  systemd, Google Drive y SMTP de prueba.
# ═══════════════════════════════════════════════════════════════

# ── Django Core ───────────────────────────────────────────────
# Generar uno DISTINTO al de producción con:
#   python -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-de-staging-distinta-a-produccion

# Staging debe comportarse como producción (DEBUG=False) para que las
# pruebas sean representativas — la única diferencia real con prod deben
# ser los datos, el dominio y las credenciales, no el modo de Django.
DJANGO_DEBUG=False
AUTH_COOKIE_SECURE=True

# Dominio de staging — NUNCA el de producción.
DJANGO_ALLOWED_HOSTS=staging.tudominio.com

# ── Base de Datos — instancia/nombre PROPIO, nunca el de producción ──
DB_ENGINE=postgresql
DB_NAME=octopus_staging
DB_USER=octopus_staging_user
DB_PASSWORD=cambia-esto-password-de-staging
DB_HOST=localhost
DB_PORT=5432

# ── CORS y CSRF — solo el dominio de staging ───────────────────
DJANGO_CORS_ORIGINS=https://staging.tudominio.com
DJANGO_CSRF_ORIGINS=https://staging.tudominio.com

# ── Email SMTP — SIEMPRE una cuenta de pruebas (Mailtrap, Mailhog, etc.),
# JAMÁS las credenciales SMTP reales del colegio. El objetivo es que un
# correo de prueba (recordatorio de mora, boletín, etc.) enviado desde
# staging NUNCA llegue a la bandeja de un representante real.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USE_TLS=True
EMAIL_HOST_USER=cambia-esto-usuario-mailtrap-staging
# Credencial de la cuenta de pruebas SMTP, nunca la del colegio real.
EMAIL_HOST_PASSWORD=

# ── Portal de Representantes — remitente y director de PRUEBA ──
PORTAL_EMAIL_FROM=staging-noreply@tudominio.com
# Usar un correo de prueba propio del equipo, nunca el del director real
# del colegio-cliente — staging puede disparar la alerta de día 15 varias
# veces mientras se prueba.
PORTAL_EMAIL_DIRECTOR=staging-tester@tudominio.com

# ── Celery + Redis — MISMO servidor Redis que producción está bien,
# pero SIEMPRE un número de base de datos distinto (el índice al final
# de la URL). Compartir el índice 0 con producción mezclaría las colas
# de tareas de staging y producción en el mismo worker/broker.
# Producción usa redis://localhost:6379/0 — staging usa el índice 1.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Respaldos externos diarios (Google Drive) ──────────────────
# Dejar estas tres variables VACÍAS (comentadas) es la opción más segura
# para staging: el respaldo diario automático (ver CELERY_BEAT_SCHEDULE en
# config/settings.py) simplemente no se ejecuta si faltan, sin error.
# Si de verdad se necesita probar el flujo de respaldo, usar una cuenta de
# servicio y una carpeta de Drive DISTINTAS a las de producción — nunca
# apuntar GOOGLE_DRIVE_BACKUP_FOLDER_ID a la carpeta real del colegio.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=/etc/octopus-staging/google-drive-backup-staging.json
# GOOGLE_DRIVE_BACKUP_FOLDER_ID=identificador-de-carpeta-de-drive-de-staging
# BACKUP_ALERT_EMAILS=staging-tester@tudominio.com
# Directorio de respaldo LOCAL AL CHECKOUT DE STAGING — nunca la ruta de
# respaldos de producción, para no mezclar ni sobrescribir volcados reales.
# BACKUP_DIR=/var/www/octopus-staging/octopus-api/media/backups
# BACKUP_RETENTION_DAYS=14

# ── URL del Frontend — build de staging, nunca el de producción ─
FRONTEND_URL=https://staging.tudominio.com

# ── WhatsApp (implementación futura) — no configurar en staging hasta
# que exista una cuenta de pruebas de Twilio/Meta separada de la real.
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_PHONE_ID=
# DIRECTOR_WHATSAPP=
